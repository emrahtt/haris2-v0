# ============================================================
# HARIS — Çevre Değişkenleri (Faz 8 — Full Production)
# ============================================================
# HİÇBİRİNİ DOLDURMASANIZ DA UYGULAMA TAM ÇALIŞIR (Demo Mode).
# Production deploy için aşağıdaki gruplar gerekli.
# ============================================================

# --- APP ---
# Production URL (Vercel domain veya custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SUPABASE (Auth + DB + Storage + pgvector) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI SAĞLAYICILAR ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Varsayılan model
HARIS_DEFAULT_MODEL=openai:gpt-4o-mini

# Karşı Taraf Simülatörü için ayrı model (premium)
HARIS_ADVERSARIAL_MODEL=anthropic:claude-3-5-sonnet-20241022

# Maks token / request
HARIS_MAX_TOKENS=4000

# --- BELGEDEN METİN ÇIKARMA (OCR) ---
# Görsel analiz modelinden (HARIS_VISION_MODEL) bağımsızdır.
GEMINI_API_KEY=
HARIS_OCR_MODEL=google:gemini-3.8-flash
HARIS_OCR_FALLBACK_MODEL=google:gemini-3.5-flash
HARIS_OCR_CLAUDE_MODEL=anthropic:claude-sonnet-4-6
HARIS_OCR_OPENAI_MODEL=openai:gpt-4o

# --- GÖRSEL ANALİZ (yorum / değerlendirme) ---
HARIS_VISION_MODEL=anthropic:claude-opus-5

# ============================================================
# Faz 7: SCRAPING (Yargıtay/Danıştay/AYM)
# ============================================================

# Gerçek Yargıtay scraping aktif et (production'da dikkatli)
YGT_SCRAPER_ENABLED=false

# Bedesten API rate-limit ince ayar (opsiyonel)
# BEDESTEN_RATE_REFILL_S=3.5
# BEDESTEN_RATE_MAX_WAIT_S=8

# Vercel Cron için güvenlik token
CRON_SECRET=

# ============================================================
# Faz 8: ÖDEME (Stripe / iyzico)
# ============================================================

# --- Stripe (international) ---
# Dashboard → API keys → Secret key
STRIPE_SECRET_KEY=
# Dashboard → Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Dashboard → API keys → Publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- iyzico (Türkiye yerel, opsiyonel) ---
# iyzico Sandbox/Live keys
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Trial periyodu (gün)
HARIS_TRIAL_DAYS=14

# Default currency: try | usd
HARIS_DEFAULT_CURRENCY=try

# Sizin kullanıcı UUID'niz — kota uygulanmaz (platform sahibi)
HARIS_OWNER_USER_IDS=
